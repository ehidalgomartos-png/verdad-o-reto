# V/R Match · configuración local/Render
VR_STORAGE_DIR=./
VR_APP_BASE_URL=http://localhost:3000
VR_ALLOWED_ORIGINS=http://localhost:3000
VR_REQUIRE_EMAIL_VERIFICATION=false
VR_LAUNCH_MODE=beta
# Durante beta/lanzamiento: activa todos los extras V/R+ gratis y bloquea el checkout.
VR_FREE_PREMIUM_DURING_LAUNCH=true

# V/R+ Billing · dejar false hasta terminar pruebas en Stripe Sandbox
VR_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=

# Separa varios administradores con comas
VR_ADMIN_EMAILS=tu-correo@ejemplo.com

# SMTP: necesario para recuperación y verificación. En Render Free usar 2465 con Resend.
SMTP_HOST=smtp.resend.com
SMTP_PORT=2465
SMTP_USER=resend
SMTP_PASS=tu_api_key_de_resend
SMTP_FROM="V/R Match <onboarding@resend.dev>"
SMTP_SECURE=true

# Web Push (opcional durante beta). Genera claves con: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
