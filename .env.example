# V/R Match · configuración local/Render
VR_STORAGE_DIR=./
VR_APP_BASE_URL=http://localhost:3000
VR_ALLOWED_ORIGINS=http://localhost:3000
VR_REQUIRE_EMAIL_VERIFICATION=false

# Separa varios administradores con comas
VR_ADMIN_EMAILS=tu-correo@ejemplo.com

# SMTP: necesario para recuperación y verificación. En Render Free usar 2465 con Resend.
SMTP_HOST=smtp.resend.com
SMTP_PORT=2465
SMTP_USER=resend
SMTP_PASS=tu_api_key_de_resend
SMTP_FROM="V/R Match <onboarding@resend.dev>"
SMTP_SECURE=true
