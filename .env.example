# V/R Match · configuración local/Render
VR_STORAGE_DIR=./
VR_APP_BASE_URL=http://localhost:3000
VR_ALLOWED_ORIGINS=http://localhost:3000
VR_REQUIRE_EMAIL_VERIFICATION=false

# Separa varios administradores con comas
VR_ADMIN_EMAILS=tu-correo@ejemplo.com

# SMTP: necesario para recuperación de contraseña y verificación de correo
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=usuario
SMTP_PASS=contraseña
SMTP_FROM="V/R Match <no-reply@ejemplo.com>"
SMTP_SECURE=false
